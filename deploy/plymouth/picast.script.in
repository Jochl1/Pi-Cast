# Pi-Cast boot splash. Generated from deploy/plymouth/picast.script.in by
# src/boot.js; @NAME@ placeholders are filled in from the current theme.
#
# Layout is designed for 1080p and scaled to the actual screen: the wordmark,
# three dots below it that pulse one after another like the TV's loading dots
# (screens.dots()), and "STARTING UP" at the bottom. Plymouth draws in
# software, so the dots only change every few frames.

Window.SetBackgroundTopColor(@BG_R@, @BG_G@, @BG_B@);
Window.SetBackgroundBottomColor(@BG_R@, @BG_G@, @BG_B@);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
scale = screen_h / 1080;
animate = @ANIMATE@;

fun load(file) {
  img = Image(file);
  return img.Scale(Math.Int(img.GetWidth() * scale), Math.Int(img.GetHeight() * scale));
}

# --- Wordmark, dots and "STARTING UP" ---
wordmark.image = load("wordmark.png");
wordmark.sprite = Sprite(wordmark.image);
status.image = load("status.png");
status.sprite = Sprite(status.image);

block_h = wordmark.image.GetHeight() + 54 * scale + 26 * scale;
top = (screen_h - block_h) / 2;
wordmark.sprite.SetPosition(Math.Int((screen_w - wordmark.image.GetWidth()) / 2), Math.Int(top), 10);
status.sprite.SetPosition(Math.Int((screen_w - status.image.GetWidth()) / 2),
  Math.Int(screen_h - 60 * scale - status.image.GetHeight()), 10);

# The dot images are 26 px (radius 13, the largest a dot gets).
dot_image = Image("dot.png");
accent_image = Image("dot-accent.png");
dots_cy = top + wordmark.image.GetHeight() + 54 * scale + 13 * scale;
for (i = 0; i < 3; i++) {
  dot[i].sprite = Sprite();
  dot[i].sprite.SetZ(10);
  dot[i].cx = screen_w / 2 + (i - 1) * 36 * scale;
}

# Dot i (0..2, the middle one in the accent) at `pulse` 0..1: radius 9..13,
# and brighter, as in screens.dots().
fun show_dot(i, pulse) {
  if (i == 1) {
    img = accent_image;
    opacity = 0.55 + 0.45 * pulse;
  } else {
    img = dot_image;
    opacity = 0.25 + 0.5 * pulse;
  }
  size = Math.Int(2 * (9 + 4 * pulse) * scale);
  dot[i].sprite.SetImage(img.Scale(size, size));
  dot[i].sprite.SetX(Math.Int(dot[i].cx - size / 2));
  dot[i].sprite.SetY(Math.Int(dots_cy - size / 2));
  dot[i].sprite.SetOpacity(opacity);
}

# A 1.2 s cycle; each dot swells in turn.
fun place_dots(t) {
  phase = t / 1.2;
  for (i = 0; i < 3; i++) {
    p = phase - i / 3 + 1;
    p = p - Math.Int(p);
    c = Math.Cos(p * 2 * 3.14159265);
    if (c < 0) c = 0;
    show_dot(i, c * c);
  }
}

if (animate) {
  place_dots(0);
} else {
  show_dot(0, 0);
  show_dot(1, 1);
  show_dot(2, 0);
}

# --- Animation: ~12 updates per second at Plymouth's ~50 Hz refresh ---
frame = 0;
fun refresh() {
  frame++;
  if (animate && frame % 4 == 0) place_dots(frame / 50);
}
Plymouth.SetRefreshFunction(refresh);

# No password prompts or messages: Pi-Cast has nothing to ask at boot.
fun noop() {}
Plymouth.SetMessageFunction(noop);
